# Required. Generate with: node -e "console.log('base64:'+require('crypto').randomBytes(32).toString('base64'))"
CW2_MASTER_KEY=

# Required only the first time a new database is initialized.
CW2_ADMIN_PASSWORD=
CW2_ADMIN_USERNAME=admin

CW2_HOST=127.0.0.1
CW2_PORT=8787
CW2_DATA_DIR=./data

# Docker host publishing address. Keep loopback unless a firewall or HTTPS proxy protects it.
CW2_BIND_ADDRESS=127.0.0.1
CW2_TRUST_PROXY=false
CW2_SECURE_COOKIES=auto
CW2_ALLOWED_ORIGINS=
# Required before OIDC can be enabled. Use the externally visible origin only (no path).
# Production must use HTTPS; loopback HTTP is accepted for local development.
CW2_PUBLIC_URL=
CW2_LOG_LEVEL=info
