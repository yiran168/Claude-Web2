# Claude Web2 Proxy Configuration
# Copy to .env and fill in your values

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Claude.ai authentication (sessionKey format: sk-ant-sid01-...)
# Add one session key per line
SESSIONS=sk-ant-sid01-xxxxxxxxxxxxxxxxxxxxxxxx

# Claude.ai cookies (Netscape format, one per line)
# COOKIES={"claude.ai": [{"name": "sessionKey", "value": "xxx", ...}]}
COOKIES=

# OAuth tokens (JSON format, one per line)
# OAUTH_TOKENS={"access_token": "...", "refresh_token": "...", "expires_at": 1234567890}
OAUTH_TOKENS=

# Proxy (optional)
# PROXY=http://user:pass@host:port
PROXY=

# Default model
DEFAULT_MODEL=claude-3-5-sonnet-20241022

# Account checking interval (seconds)
ACCOUNT_CHECK_INTERVAL=300

# Session timeout (seconds)
SESSION_TIMEOUT=600

# Retry attempts
RETRY_ATTEMPTS=3

# Data directory
DATA_FOLDER=./data

# Claude.ai URL
CLAUDE_AI_URL=https://claude.ai
