# Claude Web2 Proxy Configuration
# Copy to .env and fill in your values

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Claude.ai authentication (sessionKey format: sk-ant-sid01-...)
# Add one session key per line (JSON format)
# SESSIONS=["sk-ant-sid01-xxx", "sk-ant-sid01-yyy"]
SESSIONS=[]

# Claude.ai cookies (Netscape format, one per line)
# COOKIES={"claude.ai": [{"name": "sessionKey", "value": "xxx", ...}]}
COOKIES=

# OAuth tokens (JSON format, one per line)
# OAUTH_TOKENS={"access_token": "...", "refresh_token": "...", "expires_at": 1234567890}
OAUTH_TOKENS=

# OAuth settings (for token refresh)
OAUTH_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e
OAUTH_TOKEN_URL=https://console.anthropic.com/v1/oauth/token

# Proxy (optional)
# PROXY=http://user:pass@host:port
PROXY=

# Default model
DEFAULT_MODEL=claude-3-5-sonnet-20241022

# Account checking interval (seconds)
ACCOUNT_CHECK_INTERVAL=300

# Session timeout (seconds)
SESSION_TIMEOUT=600

# Retry attempts
RETRY_ATTEMPTS=3

# Data directory
DATA_FOLDER=./data

# Claude.ai URL
CLAUDE_AI_URL=https://claude.ai
